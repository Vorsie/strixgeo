#!/usr/bin/env bash
# Pre-commit guard — runs the fast unit-test layer on every commit so a
# regression can't slip through to push / PR.
#
# Strategy
# --------
# * Skip entirely when no Python or TypeScript files are staged — the
#   doc-only / config-only commits don't need a test run.
# * Run ``uv run pytest tests/unit -q`` when ANY ``.py`` file is staged.
# * Run ``npm test`` (Vitest) when ANY ``.ts`` / ``.tsx`` file under
#   ``desktop/`` is staged.
#
# Skip in dire emergencies with ``git commit --no-verify``. The
# project's CLAUDE.md says don't reach for that without a reason.
#
# Install (one-time): ``git config core.hooksPath .githooks``

set -e

staged="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -z "$staged" ]; then
  exit 0
fi

py_changed="$(echo "$staged" | grep -E '\.py$' || true)"
ts_changed="$(echo "$staged" | grep -E '^desktop/.*\.(ts|tsx)$' || true)"

# Batch mode — STRIX_BATCH=1 skips the per-commit test layers (pytest,
# tsc, Vitest, e2e smoke) and keeps only the instant guards (CLAUDE.md
# budget, eslint-reason). Rationale: this hook checks the WORKING TREE,
# and during a scripted one-file-per-commit landing batch the working
# tree is the identical final state for every commit — N re-runs of the
# same suite prove nothing the first run didn't. The contract: the
# session main runs the full gates (pytest unit, tsc web+node, full
# Vitest) on the final tree BEFORE the batch, and the re-armed develop
# CI re-proves on push (owner ruling 2026-08-27). Set by landing batch
# scripts ONLY — never export STRIX_BATCH in an interactive shell.
batch_mode="${STRIX_BATCH:-0}"
if [ "$batch_mode" = "1" ]; then
  echo "[pre-commit] STRIX_BATCH=1 — skipping test layers (full gates ran on the final tree; CI re-proves on push)."
fi

# CLAUDE.md size budget — the file auto-loads into every session, so
# every byte is paid for on every conversation (see CLAUDE.md →
# "Maintaining this file"). History belongs in docs/debt.md or
# docs/design/*.md, not here.
if echo "$staged" | grep -qx 'CLAUDE.md'; then
  claude_md_size="$(wc -c < CLAUDE.md)"
  budget=$((40 * 1024))
  if [ "$claude_md_size" -gt "$budget" ]; then
    echo "[pre-commit] CLAUDE.md is $((claude_md_size / 1024)) KB (> 40 KB budget)."
    echo "[pre-commit] Extract history to docs/debt.md or docs/design/*.md instead (see 'Maintaining this file')."
    exit 1
  fi
fi

if [ -n "$py_changed" ] && [ "$batch_mode" != "1" ]; then
  echo "[pre-commit] Running Python unit tests…"
  uv run pytest tests/unit -q --tb=no
fi

if [ -n "$ts_changed" ]; then
  if [ "$batch_mode" = "1" ]; then
    echo "[pre-commit] Batch mode — eslint-reason only for the staged TS files."
  else
    echo "[pre-commit] Running desktop checks (eslint-reason + tsc + Vitest)…"
  fi
  # eslint-reason — enforces CLAUDE.md's "every
  # eslint-disable-next-line react-hooks/exhaustive-deps must carry a
  # `// reason:` comment" rule. Cheapest of the three, runs first.
  # Debt #42. Invoke via ``uv run python`` (not bare ``python``) — on the
  # dev machine only the uv-managed interpreter is on PATH, so a bare
  # ``python`` aborts the whole desktop check and silently pushes commits
  # to ``--no-verify``. Mirrors the ``uv run pytest`` line above.
  uv run python scripts/check_eslint_reason.py
  if [ "$batch_mode" = "1" ]; then
    exit 0
  fi
  # tsc --noEmit catches type errors before a green test suite can
  # mask them (vitest happily runs against ``any`` annotations and
  # missing generic args; tsc doesn't). Runs second — slower than
  # the eslint-reason scan, faster than the test suite. Debt #63:
  # the explicit `-p tsconfig.web.json` is load-bearing — the root
  # tsconfig.json has empty `files` + project `references`, so a
  # bare `tsc --noEmit` silently checks nothing (which is what it
  # had been doing for a long time; the gate is now real). Pin
  # Node 22 LTS to run the hook — Node 24 segfaults vitest before
  # any test loads (see memory/project_node_22_pin.md).
  (cd desktop && npx tsc --noEmit -p tsconfig.web.json)

  # Vitest — run only tests affected by the staged TS files. The full
  # suite is ~80 s for 109 files / 1239 tests; ``vitest related`` walks
  # the import graph from each given source file to find the test files
  # that exercise it, typically 3-20 tests for a focused commit (~5-15 s).
  # When a test file itself is staged, vitest runs it directly.
  # If vitest config / setup files are staged, fall back to the full
  # suite — their changes affect every test.
  ts_paths_rel="$(echo "$ts_changed" | sed 's|^desktop/||' | tr '\n' ' ')"
  config_changed="$(echo "$ts_changed" | grep -E '(vitest\.|vite\.config|tsconfig)' || true)"
  if [ -n "$config_changed" ]; then
    echo "[pre-commit] Vitest config touched — running full suite."
    (cd desktop && npm test --silent)
  else
    echo "[pre-commit] Vitest related to: $ts_paths_rel"
    # shellcheck disable=SC2086
    (cd desktop && npx vitest related --run $ts_paths_rel)
  fi

  # Playwright e2e smoke (flow_boot_open only, ~10 s budget).
  # Only runs when the FastAPI backend is reachable — skips gracefully if
  # it isn't so offline / first-boot commits don't block.
  # Pre-conditions: `npm run build` inside desktop/ must have been run, and
  # E2E_FIXTURE_PROJECT_ID must be set (populated by build_synthetic_fixture.py).
  # Total target budget: Vitest (~15 s) + smoke (~10 s) ≤ 30 s.
  if curl -sf http://127.0.0.1:8765/openapi.json >/dev/null 2>&1; then
    if [ -f "desktop/out/main/index.js" ]; then
      echo "[pre-commit] Running e2e smoke (flow_boot_open)…"
      (cd desktop && npm run test:e2e:smoke --silent) || {
        echo "[pre-commit] Smoke failed — commit blocked. Fix or skip with --no-verify."
        exit 1
      }
    else
      echo "[pre-commit] Skipping smoke — desktop/out/main/index.js not built (run npm run build)."
    fi
  else
    echo "[pre-commit] Skipping smoke — FastAPI backend not reachable on :8765."
  fi
fi

exit 0
