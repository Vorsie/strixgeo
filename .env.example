DATABASE_URL=postgresql+asyncpg://groundmodel:groundmodel@localhost:5433/groundmodel
DEBUG=false
# TRACE in dev so per-edge LCS decisions and other DEBUG/TRACE logs are visible
# without a re-run.  Production / packaged builds raise this to INFO or WARNING
# by setting LOG_LEVEL in their environment.
LOG_LEVEL=TRACE
ENVIRONMENT=development
# SECRET_KEY has no default outside local development — set a real value
# before running with ENVIRONMENT set to anything other than "development".
SECRET_KEY=
