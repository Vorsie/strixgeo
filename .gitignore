.hypothesis/

# Profiling output (Phase 3/4 performance work)
*.prof
*.lprof
prof/

# pytest-benchmark snapshots — local hardware baselines, don't share across machines
.benchmarks/

# Single-runner lock held by scripts/run-integration-tests.ps1 while the
# integration suite runs. Machine-local and PID-bearing, so it is never shared.
.integration-test.lock*

# Geotechnical data files — use tests/fixtures/ for small synthetic test files
data/
# Exception: codelists archive — authoritative DOV reference CSVs that
# DO need to be checked in (see src/groundmodel/infrastructure/codelists/).
!src/groundmodel/infrastructure/codelists/data/
!src/groundmodel/infrastructure/codelists/data/**
# Exception: shell/stages/data — the Data stage descriptor lives here, not
# geotechnical data files (those live in tests/fixtures/ or the DOV cache).
!desktop/src/renderer/src/shell/stages/data/
!desktop/src/renderer/src/shell/stages/data/**

# Generated outputs
reports/
uploads/

# TypeScript incremental-build caches — local only, not source
*.tsbuildinfo
.superpowers/

# Playwright e2e run artifacts — local only (#165b)
desktop/tests/e2e/_results/
*.e2e-backend.err
.e2e-backend.err

# brainstorm visual companion (local, never commit)
.superpowers/
desktop/scripts/voxel_oracle_inputs.json

# Voxel-litho dev viewer — local dogfeed tool; model.json is a large (~19 MB)
# regenerable artifact (scripts/dump_voxel_viewer_model.py rebuilds it from the
# persisted solids). Never commit the viewer or its generated model/screenshots.
voxel_viewer/

# Real-data geotech gate input — extracted from dev DB; regenerable.
# Regenerate: scripts/rematerialise_dev_geotech.py + scripts/throwaway_cs1_geotech_gate_extract.py
scripts/cs1_geotech_gate.json

# StrixGeo user manual — Sphinx build output (regenerable via scripts/build-manual.ps1)
docs/manual/_build/

# The line-by-line code guide is a LOCAL reading copy (owner 2026-09-05): its
# 1518 generated pages + prose are not versioned. Backup: .backups/code-guide-*.zip
docs/code-guide/

# Vitest conformance byproducts (partitionFillV2 oracle + diag runs)
scripts/oracle210_conformance.json
scripts/diag_conformance.json

# Scratch dir for the behavioural native gate (scripts/verify-staged-natives.ps1).
# Repo-local on purpose: see the comment there about the %TEMP% collection race.
.native-gate-work/
