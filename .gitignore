# ─────────────────────────────────────────────────────────────────────────────
# Python bytecode and compiled extensions
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/          # compiled .pyc cache directories
*.py[cod]             # .pyc / .pyo / .pyd compiled bytecode
*$py.class            # Jython compiled classes
*.so                  # C extension modules (compiled with gcc/clang)
*.egg                 # setuptools egg archives
*.egg-info/           # setuptools metadata directories
dist/                 # pip / build output
build/                # setuptools build directory
eggs/                 # old-style egg directories
parts/                # buildout parts
var/                  # buildout var
sdist/                # sdist tarballs
develop-eggs/         # develop-mode eggs
.installed.cfg        # buildout installed config
lib/                  # buildout lib
lib64/                # buildout lib64 (Linux)
.eggs/                # pytest egg cache
*.whl                 # wheel archives
MANIFEST              # auto-generated by setuptools

# ─────────────────────────────────────────────────────────────────────────────
# Virtual environments — never commit; always recreate with `uv sync`
# ─────────────────────────────────────────────────────────────────────────────
.venv/                # UV / pip venv (project standard)
venv/                 # alternative venv name
env/                  # alternative venv name
ENV/                  # alternative venv name (uppercase)
.env                  # environment variables / secrets file
.env.*                # environment-specific overrides (.env.production, etc.)
!.env.example         # ← KEEP: template showing which vars are needed

# ─────────────────────────────────────────────────────────────────────────────
# Test & coverage artefacts
# ─────────────────────────────────────────────────────────────────────────────
.pytest_cache/        # pytest internal cache
.coverage             # coverage.py data file
.coverage.*           # coverage per-process files (parallel mode)
htmlcov/              # HTML coverage report
.tox/                 # tox environments
nosetests.xml         # nose JUnit output
coverage.xml          # coverage XML report (for CI)
*.cover               # coverage annotation files

# ─────────────────────────────────────────────────────────────────────────────
# Linter / type-checker caches
# ─────────────────────────────────────────────────────────────────────────────
.mypy_cache/          # mypy incremental type-check cache
.ruff_cache/          # ruff lint cache
pyrightconfig.json    # Pyright / Pylance config (editor-local, not project-wide)

# ─────────────────────────────────────────────────────────────────────────────
# Jupyter notebooks (used for ad-hoc exploration, not source-controlled here)
# ─────────────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/   # auto-save checkpoints
*.ipynb               # notebook files themselves

# ─────────────────────────────────────────────────────────────────────────────
# Distribution / packaging
# ─────────────────────────────────────────────────────────────────────────────
*.manifest            # Windows application manifest
*.spec                # PyInstaller spec files

# ─────────────────────────────────────────────────────────────────────────────
# Log files
# ─────────────────────────────────────────────────────────────────────────────
*.log                 # any log file
logs/                 # log directory

# ─────────────────────────────────────────────────────────────────────────────
# Local databases (Docker Compose runs the real DB; these are throwaway files)
# ─────────────────────────────────────────────────────────────────────────────
*.db                  # SQLite database files
*.sqlite3             # SQLite3 database files
*.sqlite              # SQLite database files (alternate extension)

# ─────────────────────────────────────────────────────────────────────────────
# Alembic — keep alembic.ini and migrations/ tracked; only exclude local overrides
# ─────────────────────────────────────────────────────────────────────────────
alembic.ini.local     # per-developer DB URL override (contains credentials)

# ─────────────────────────────────────────────────────────────────────────────
# Docker local state
# ─────────────────────────────────────────────────────────────────────────────
.docker/              # Docker Desktop local config / context files

# ─────────────────────────────────────────────────────────────────────────────
# IDE / editor files
# ─────────────────────────────────────────────────────────────────────────────
.idea/                # JetBrains (PyCharm, WebStorm, …) project files
.vscode/              # VS Code workspace settings
*.swp                 # Vim swap file
*.swo                 # Vim swap file (overflow)
*~                    # Emacs / Vim backup files
.DS_Store             # macOS Finder metadata
Thumbs.db             # Windows Explorer thumbnail cache

# ─────────────────────────────────────────────────────────────────────────────
# Rust / PyO3 (Phase 4 only — groundmodel_core native extension)
# ─────────────────────────────────────────────────────────────────────────────
target/               # Cargo build output
Cargo.lock            # Cargo lock file (tracked for binaries, excluded for libs)
*.pdb                 # Windows debug symbol database

# ─────────────────────────────────────────────────────────────────────────────
# Node / frontend (Electron + React via electron-vite)
# ─────────────────────────────────────────────────────────────────────────────
node_modules/         # npm / yarn dependency tree — never commit; run `npm ci`
.pnp                  # Yarn Plug'n'Play entrypoint
.pnp.js               # Yarn PnP runtime
.yarn/install-state.gz  # Yarn install state cache
out/                  # electron-vite production output (desktop/out/)
.next/                # Next.js build cache (not used here, precautionary)
.nuxt/                # Nuxt.js build cache (not used here, precautionary)
.cache/               # generic build tool cache

# ─────────────────────────────────────────────────────────────────────────────
# Compiled WebAssembly / native Node addons
# ─────────────────────────────────────────────────────────────────────────────
*.wasm                # WebAssembly binary
*.node                # native Node.js addon

# ─────────────────────────────────────────────────────────────────────────────
# Secrets & credentials — never commit private keys or certificates
# ─────────────────────────────────────────────────────────────────────────────
*.pem                 # PEM-encoded certificate or private key
*.key                 # raw private key
*.p12                 # PKCS#12 certificate bundle
*.pfx                 # PFX certificate (Windows name for PKCS#12)
secrets/              # secrets directory
credentials/          # credentials directory

# ─────────────────────────────────────────────────────────────────────────────
# OS-generated files
# ─────────────────────────────────────────────────────────────────────────────
ehthumbs.db           # Windows Explorer thumbnail cache (alternative)
Desktop.ini           # Windows folder display settings
$RECYCLE.BIN/         # Windows Recycle Bin

# ─────────────────────────────────────────────────────────────────────────────
# Claude Code project settings
# settings.local.json  — per-machine tool permissions (absolute paths differ per OS)
# hooks/               — hook scripts reference local .venv paths
# CLAUDE.md            — project AI instructions are committed at root level;
#                        sub-directory CLAUDE.md files (if any) stay local
# CLAUDE.local.md      — private developer notes, never shared
# ─────────────────────────────────────────────────────────────────────────────
.claude/settings.local.json
.claude/hooks/
CLAUDE.md
CLAUDE.local.md

# ─────────────────────────────────────────────────────────────────────────────
# Python version manager pin files (each dev uses their own Python toolchain)
# ─────────────────────────────────────────────────────────────────────────────
.python-version       # pyenv / uv pin file

# ─────────────────────────────────────────────────────────────────────────────
# Git merge conflict backups
# ─────────────────────────────────────────────────────────────────────────────
*.orig                # conflict backup files left by git mergetool

# ─────────────────────────────────────────────────────────────────────────────
# Hypothesis property-based testing cache
# ─────────────────────────────────────────────────────────────────────────────
.hypothesis/          # auto-generated example database

# ─────────────────────────────────────────────────────────────────────────────
# Profiling output (Phase 3/4 performance work — never commit raw profiles)
# ─────────────────────────────────────────────────────────────────────────────
*.prof                # cProfile / Scalene output
*.lprof               # line_profiler output
prof/                 # profiling output directory

# ─────────────────────────────────────────────────────────────────────────────
# Geotechnical data files
# Real GEF/AGS/LAS files from clients/DOV are gitignored for two reasons:
#   1. They may be commercially sensitive or covered by data-sharing agreements
#   2. They can be large (MB-range per file)
# Use tests/fixtures/ for small synthetic files that must be in version control.
# ─────────────────────────────────────────────────────────────────────────────
data/

# ─────────────────────────────────────────────────────────────────────────────
# Generated outputs — produced by the application at runtime, not source files
# ─────────────────────────────────────────────────────────────────────────────
reports/              # generated PDF / HTML reports
uploads/              # temporary upload staging directory
