{
  "name": "ground-model-desktop",
  "version": "0.2.0",
  "description": "StrixGeo — desktop client",
  "license": "AGPL-3.0-or-later",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.0.0 <24.0.0"
  },
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && node scripts/sync-cesium-public.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-cesium.mjs",
    "preview": "electron-vite preview",
    "package": "electron-vite build && node scripts/copy-cesium.mjs && node scripts/require-build-sha.mjs && electron-builder --publish=never",
    "embedded:postgres": "powershell -ExecutionPolicy Bypass -File ../scripts/build-embedded-postgres.ps1",
    "embedded:python": "powershell -ExecutionPolicy Bypass -File ../scripts/build-embedded-python.ps1",
    "dist": "node scripts/require-clean-release.mjs && npm run embedded:postgres && npm run embedded:python && npm run package",
    "release": "node scripts/require-clean-release.mjs release && npm run dist && electron-builder --publish=always",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:smoke": "playwright test tests/e2e/flow_boot_open.spec.ts",
    "test:e2e:full": "playwright test"
  },
  "dependencies": {
    "cesium": "^1.146.0",
    "electron-updater": "^6.8.9",
    "jsts": "^2.12.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "proj4": "^2.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "2.3.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/serve-static": "^2.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "42.11.14",
    "electron-builder": "^26.8.1",
    "electron-vite": "^6.0.0",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.3",
    "serve-static": "^2.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.groundmodel.desktop",
    "productName": "StrixGeo",
    "icon": "resources/icon.ico",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StrixGeo",
      "artifactName": "StrixGeo-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Vorsie",
        "repo": "strixgeo",
        "releaseType": "draft"
      }
    ],
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "embedded/pgsql",
        "to": "pgsql"
      },
      {
        "from": "embedded/python",
        "to": "python"
      },
      {
        "from": "embedded/backend",
        "to": "backend"
      },
      {
        "from": "resources/sample",
        "to": "sample"
      }
    ],
    "compression": "normal"
  }
}
