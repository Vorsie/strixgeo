{
  "name": "ground-model-desktop",
  "version": "0.1.0",
  "description": "Ground Model Platform — desktop client",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.0.0 <24.0.0"
  },
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && node scripts/sync-cesium-public.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-cesium.mjs",
    "preview": "electron-vite preview",
    "package": "electron-vite build && node scripts/copy-cesium.mjs && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cesium": "^1.141.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.513.0",
    "proj4": "^2.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.15.21",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/serve-static": "^2.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "fs-extra": "^11.3.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "serve-static": "^2.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.groundmodel.desktop",
    "productName": "Ground Model",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  }
}
